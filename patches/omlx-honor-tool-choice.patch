+def _inject_tool_instruction(messages: list, instruction: str) -> list:
+    """
+    Inject a forced-tool-call instruction into the LAST user message.
+
+    Deliberately NOT the system turn that _inject_json_instruction uses:
+    Gemma 4 reliably ignores a MUST-call instruction placed in the system
+    turn (measured 2026-09-16 on gemma-4-26B-A4B-it-qat-4bit, temperature 0:
+    0/8 forced calls, even when the client itself put the instruction into
+    its own system message), but follows the identical text appended to the
+    last user message (6/6 across chit-chat, unrelated questions, multi-tool,
+    named-function and document-classification prompts, thinking on and off).
+    Falls back to the system-turn injection when there is no user message.
+    """
+    messages = list(messages)  # Make a copy
+    for idx in range(len(messages) - 1, -1, -1):
+        msg = messages[idx]
+        role = msg.get("role") if isinstance(msg, dict) else getattr(msg, "role", None)
+        if role != "user":
+            continue
+        content = (
+            msg.get("content") if isinstance(msg, dict) else getattr(msg, "content", None)
+        )
+        if isinstance(content, list):
+            # Multimodal parts list (text/image_url) -- append a text part.
+            new_content = list(content) + [{"type": "text", "text": instruction}]
+        else:
+            new_content = f"{content or ''}\n\n{instruction}"
+        if isinstance(msg, dict):
+            msg = dict(msg)
+            msg["content"] = new_content
+        else:
+            msg.content = new_content
+        messages[idx] = msg
+        return messages
+    return _inject_json_instruction(messages, instruction)
+
+
+def _forced_tool_instruction(tool_choice, tools_for_template) -> str | None:
+    """MUST-call instruction for tool_choice "required"/"any"/named function.
+
+    oMLX only inspects ``tool_choice == "none"``; every other value is
+    silently treated as "auto", so a model that prefers prose (Gemma 4 on
+    short prompts) returns no tool call at all. Clients that hard-require one
+    -- llama-index's chat_with_tools(tool_required=True), used by
+    paperless-ngx v3 AI suggestions -- then fail with "Expected at least one
+    tool call, but got 0 tool calls". Prompt-injection degrade, like
+    response_format, but into the LAST USER turn (see
+    _inject_tool_instruction for why).
+    """
+    if not tools_for_template:
+        return None
+    forced_tool_name = None
+    force_tool_call = False
+    tc = tool_choice
+    if hasattr(tc, "model_dump"):
+        tc = tc.model_dump()
+    if isinstance(tc, str):
+        force_tool_call = tc in ("required", "any")
+    elif isinstance(tc, dict):
+        tc_fn = tc.get("function")
+        if isinstance(tc_fn, dict):
+            forced_tool_name = tc_fn.get("name")
+        forced_tool_name = forced_tool_name or tc.get("name")
+        force_tool_call = bool(forced_tool_name) or tc.get("type") in (
+            "any",
+            "required",
+        )
+    if not force_tool_call:
+        return None
+    if forced_tool_name:
+        return (
+            "You MUST answer by calling the function "
+            f"`{forced_tool_name}`. Do not reply with prose, "
+            "explanations or markdown -- emit only that function call."
+        )
+    available = ", ".join(
+        f"`{t['function']['name']}`"
+        for t in tools_for_template
+        if isinstance(t.get("function"), dict) and t["function"].get("name")
+    )
+    return (
+        "You MUST answer by calling one of the provided functions"
+        + (f" ({available})" if available else "")
+        + ". Do not reply with prose, explanations or markdown -- "
+        "emit only the function call."
+    )
+
+
 def _normalize_structured_outputs(
