#!/usr/bin/env bash
# llm-restart — restart one or all MacStudioLLM services.
#
# Usage:
#   llm-restart                 # restart every always-on service
#   llm-restart main            # restart the text engine only
#   llm-restart immich docling  # multiple
#   llm-restart all             # explicit "all"
#   llm-restart list            # show known service names
set -u

# Self-elevate: launchctl kickstart on system/ domain needs root.
if [ "$(id -u)" -ne 0 ]; then
  exec sudo "$0" "$@"
fi

# Short-name → launchd label (Bash-3.2 safe; macOS ships /bin/bash 3.2).
label_for() {
  case "$1" in
    main)            echo com.local.omlx.main ;;
    litellm)         echo com.local.litellm.proxy ;;
    immich-proxy)    echo com.local.immich.proxy ;;
    immich)          echo com.local.immich.ml ;;
    docling-proxy)   echo com.local.docling.proxy ;;
    docling)         echo com.local.docling.serve ;;
    images-proxy)    echo com.local.images.proxy ;;
    images)          echo com.local.images.serve ;;
    voicestt-proxy)  echo com.local.voicestt.proxy ;;
    voicestt)        echo com.local.voicestt.serve ;;
    voicetts-proxy)  echo com.local.voicetts.proxy ;;
    voicetts)        echo com.local.voicetts.serve ;;
    voicewyoming-proxy) echo com.local.voicewyoming.proxy ;;
    node)            echo com.local.node.exporter ;;
    silicon)         echo com.local.silicon.exporter ;;
    ondemand)        echo com.local.ondemand.exporter ;;
    watchdog)        echo com.local.llm.watchdog ;;
    preventsleep)    echo com.local.preventsleep ;;
    dashboard)       echo com.local.dashboard ;;
    mqtt)            echo com.local.mqtt.bridge ;;
    vncfilter)       echo com.local.vncfilter ;;
    novnc)           echo com.local.novnc ;;
    paperless)       echo com.local.paperless.ocr ;;
    *)               echo "" ;;
  esac
}

ALL_SHORT_NAMES=(main litellm immich-proxy immich docling-proxy docling \
                 images-proxy images \
                 voicestt-proxy voicestt voicetts-proxy voicetts voicewyoming-proxy \
                 node silicon ondemand watchdog preventsleep \
                 dashboard mqtt vncfilter novnc paperless)
ALL_ALWAYS_ON=(main litellm immich-proxy docling-proxy images-proxy \
               voicestt-proxy voicetts-proxy voicewyoming-proxy \
               node silicon ondemand watchdog preventsleep \
               dashboard mqtt vncfilter novnc paperless)

implicit_all=0
if [ $# -eq 0 ] || [ "${1:-}" = all ]; then
  implicit_all=1
  set -- "${ALL_ALWAYS_ON[@]}"
fi

if [ "${1:-}" = list ]; then
  printf "%-20s %s\n" NAME LABEL
  for k in "${ALL_SHORT_NAMES[@]}"; do printf "%-20s %s\n" "$k" "$(label_for "$k")"; done
  exit 0
fi

rc=0
for name in "$@"; do
  label=$(label_for "$name")
  if [ -z "$label" ]; then
    echo "unknown service: $name (try: llm-restart list)" >&2
    rc=1
    continue
  fi
  if /bin/launchctl print "system/$label" >/dev/null 2>&1; then
    /bin/launchctl kickstart -k "system/$label" && echo "restarted: $name ($label)"
  elif [ "$implicit_all" = 1 ]; then
    :  # disabled/absent service — skip quietly when restarting "all"
  else
    echo "not registered: $name ($label)" >&2
    rc=1
  fi
done
exit "$rc"
