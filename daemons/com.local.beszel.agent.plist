<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.local.beszel.agent</string>
  <!-- No UserName: runs as ROOT. A TARGET_USER daemon would hit macOS Local Network
       Privacy (non-Apple binary -> LAN blocked), same as com.local.paperless.ocr. -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/libexec/start-beszel-agent.sh</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/var/log/macstudio/beszel-agent.log</string>
  <key>StandardErrorPath</key><string>/var/log/macstudio/beszel-agent.log</string>
</dict>
</plist>
